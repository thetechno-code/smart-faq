{
  "version": 2,
  "functions": {
    "api/index.ts": {
      "includeFiles": "{ocr_processor.py,data/database.json}"
    }
  },
  "rewrites": [
    {
      "source": "/api/:path*",
      "destination": "/api"
    },
    {
      "source": "/((?!api/).*)",
      "destination": "/index.html"
    }
  ]
}
